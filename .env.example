# GVC Finance Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@gvcagro.lk
FROM_NAME=GVC Agro Finance

# SMS (Notify.lk - Sri Lanka)
NOTIFY_LK_API_KEY=your_notify_lk_api_key
NOTIFY_LK_USER_ID=your_notify_lk_user_id
NOTIFY_LK_SENDER_ID=GVCFinance

# File Storage (Supabase Storage bucket name)
STORAGE_BUCKET=gvc-finance-files
